      "name": "Service Meta",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "x-api-key",
            "value": "{{apiKey}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/{{serviceName}}/{{apiPrefix}}/meta",
          "host": ["{{baseUrl}}"],
          "path": ["{{serviceName}}", "{{apiPrefix}}", "meta"]
        },
        "description": "Returns deployment metadata and asserts the Mongo connection via `checkMongoDatabase`."
      },
      "response": [
        {
          "name": "200 OK",
          "originalRequest": {
            "method": "GET",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{apiKey}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/{{serviceName}}/{{apiPrefix}}/meta",
              "host": ["{{baseUrl}}"],
              "path": ["{{serviceName}}", "{{apiPrefix}}", "meta"]
            }
          },
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": "{\n  \"serviceName\": \"boilerplate\",\n  \"data\": {\n    \"message\": \"OK\",\n    \"code\": \"1b4f8b50-34b5-4d23-bf44-8b0d38e2ce41\",\n    \"platform\": \"development\",\n    \"environment\": \"development\",\n    \"dbName\": \"boilerplate\"\n  }\n}"
