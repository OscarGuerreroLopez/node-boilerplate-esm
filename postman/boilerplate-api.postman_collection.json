  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3009",
      "type": "string",
      "description": "Local development server URL (`PORT` in .env)."
    },
    {
      "key": "serviceName",
      "value": "boilerplate",
      "type": "string",
      "description": "`SERVICE_NAME` env var."
    },
    {
      "key": "apiPrefix",
      "value": "v1",
      "type": "string",
      "description": "`DEFAULT_API_PREFIX` env var (omit the leading slash)."
    },
    {
      "key": "apiKey",
      "value": "SuperHardToGuessApiKey",
      "type": "string",
      "description": "`x-api-key` required by credentials middleware."
    }
  ],
  "item": [
